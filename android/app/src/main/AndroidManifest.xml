<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Overlay permission.

      NOTE: on the `sideload` flavour this is very nearly unnecessary — an
      overlay added from inside an AccessibilityService uses
      TYPE_ACCESSIBILITY_OVERLAY, which needs no grant at all AND cannot be
      suppressed by an app calling Window.setHideOverlayWindows(true).
      We keep the permission declared so the `play` flavour, and any fallback
      path, still works.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!--
      MediaProjection path (`play` flavour only in practice).
      Android 14+ REQUIRES this dedicated foreground-service type, and the
      service must already be in the foreground BEFORE getMediaProjection()
      is called or the system throws.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!--
      Aggressive OEM battery managers (Xiaomi, Huawei, Oppo, Vivo, Samsung)
      will kill a background reader regardless of what stock Android allows.
      Onboarding walks the driver through the exemption; see dontkillmyapp.com
      for the per-vendor autostart screens.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- We only ever look at these two packages. Nothing else is queried. -->
    <queries>
        <package android:name="ee.mtakso.driver" />
        <package android:name="com.ubercab.driver" />
    </queries>

    <application
        android:name=".RideGuardApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RideGuard"
        tools:targetApi="35">

        <!--
          Resizable, and it says so rather than inheriting it.

          targetSdk 35 already defaults this to true, but the default is the
          kind of thing a later targetSdk bump or a stray library manifest can
          flip underneath you, and a driver running RideGuard in split-screen
          beside Bolt is a real use of this app.

          `configChanges` covers everything a resize actually changes. Without
          it Android destroys and recreates the Activity on every size change —
          which flickers all the way through a drag-resize. This is a pure
          Compose UI with one hard-coded dark theme and no resource qualifiers,
          so there is nothing that needed re-resolving on recreate; Compose
          reads the new size straight from the composition. State is saved with
          rememberSaveable regardless, because process death still recreates.

          `<layout>` sets the freeform floor. Below roughly this the number
          fields stop fitting side by side, and a HUD app squashed to a sliver
          is worse than one that simply refuses to get smaller.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|density|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:theme="@style/Theme.RideGuard">
            <layout
                android:defaultHeight="700dp"
                android:defaultWidth="420dp"
                android:gravity="center"
                android:minHeight="400dp"
                android:minWidth="320dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Only used by the OCR path. Declared in the shared manifest so both
          flavours compile, but only started on the `play` flavour.
        -->
        <service
            android:name=".service.ProjectionCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>
</manifest>
