<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>RideGuard</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<!-- Must stay an INTEGER. It is the only thing the updater compares:
	     `UpdateComparison` reads it with `Int(_:)` and a non-integer reads as
	     0, which makes every published release look newer forever. -->
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Live Activities are opt-in per app and silently do nothing without
	     this key — the request throws an error the controller swallows, so a
	     missing key looks exactly like a driver who declined. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!--
	  Keeps the app alive behind the Picture-in-Picture overlay.

	  PiP is the only window class iOS lets float above another app, and it
	  only survives backgrounding while the process does. An `AVAudioSession`
	  in `.playback` holds the process up; this key is what permits it.

	  The session MUST be configured `.mixWithOthers`. Without that we would
	  duck or stop the driver's music and navigation the moment the HUD
	  appeared, which is unacceptable in a car and would get the app deleted
	  faster than any bug.

	  Note this is exactly the kind of thing App Review rejects (Guideline
	  2.5.4 — background audio without playing audio). Distribution is
	  TestFlight and, in the EU, an alternative marketplace. See
	  docs/ios-platform-limits.md.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- The app has no networking beyond the update manifest, which is HTTPS
	     to raw.githubusercontent.com. No ATS exception is needed, and none
	     should ever be added: the OTA install path REQUIRES valid HTTPS. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
