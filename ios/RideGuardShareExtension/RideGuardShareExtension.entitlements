<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Must match RideGuard.entitlements and Persistence.appGroupIdentifier.
	     Without it the extension reads a default vehicle profile from its own
	     private container and produces confidently wrong verdicts. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.rideguard.shared</string>
	</array>
</dict>
</plist>
