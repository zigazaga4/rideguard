# --- build output ---
build/
dist/
*.apk
*.aab
*.ipa
*.dSYM.zip

# --- gradle ---
.gradle/
local.properties
android/local.properties
mock/android/local.properties
captures/

# --- node ---
node_modules/
.expo/
*.log
npm-debug.*
yarn-error.*

# --- expo prebuild output (regenerated by `expo prebuild`) ---
mock/android/app/build/
mock/ios/

# --- xcode ---
xcuserdata/
*.xcuserstate
DerivedData/
.swiftpm/
# Generated by `xcodegen generate` from ios/project.yml, which is the source of
# truth. A project.pbxproj is 2000 lines nobody can review and every branch
# conflicts on — regenerate it, never commit it.
ios/RideGuard.xcodeproj/
# SwiftPM's build directory, from `swift test` on the domain.
ios/.build/

# --- os / editor ---
.DS_Store
*.swp
.idea/
*.iml
.vscode/

# --- secrets: never commit a signing key ---
*.jks
*.keystore
!debug.keystore
keystore.properties
